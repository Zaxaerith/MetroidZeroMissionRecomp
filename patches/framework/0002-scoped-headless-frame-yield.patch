+// Preserve a whole-subtree dispatch boundary when a native callback replaces
+// the interpreter bridge. Device ticks, IRQ delivery, guards and debugger
+// breaks still run. Window presentation and session scheduler yields are not
+// deferred. This temporary host scope is not snapshot state.
+class DeferHeadlessFrameYield {
+public:
+    DeferHeadlessFrameYield();
+    ~DeferHeadlessFrameYield();
+    DeferHeadlessFrameYield(const DeferHeadlessFrameYield&) = delete;
+    DeferHeadlessFrameYield& operator=(const DeferHeadlessFrameYield&) = delete;
+};
 // Conservative native execution backend for the local-link qualification
 // harness. CPU instructions accrue cycle debt; the session advances devices
 // for every machine on one timeline. No machine's hardware runs ahead.
