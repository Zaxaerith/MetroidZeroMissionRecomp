diff --git a/tests/ppu_smoke/test_main.cpp b/tests/ppu_smoke/test_main.cpp
index 198b217..ddc4fec 100644
--- a/tests/ppu_smoke/test_main.cpp
+++ b/tests/ppu_smoke/test_main.cpp
@@ -1844,6 +1844,40 @@ void test_latched_frame_immune_to_in_progress_scanlines() {
 } // namespace
 
 int main() {
+    // Opaque OBJ must obey BLDCNT first-target selection for brightness.
+    // Semitransparent OBJ forces alpha, independently of that selection.
+    for (int margin : {0, 24}) {
+        Fixture f;
+        f.ppu.set_view_margins(margin, margin, 0, 0);
+        std::vector<uint8_t> pixels(f.ppu.render_bytes());
+        const uint8_t* object_pixel = pixels.data() + margin * 3;
+        disable_all_objects(f);
+        store16(f.oam.data(), 0);  // opaque 8x8 OBJ at (0,0)
+        std::fill(f.vram.begin() + 0x10000, f.vram.begin() + 0x10020, 0x11);
+        store16(&f.pal[0], 0x7C00);  // blue backdrop
+        store16(&f.pal[0x202], 0x001F);  // red OBJ
+        store16(&f.io[0x52], 0x0808);
+        store16(&f.io[0x54], 8);
+        auto render = [&]() {
+            f.ppu.render(pixels.data(), 0x1000, f.io.data(), f.vram.data(),
+                         f.oam.data(), f.pal.data());
+        };
+        store16(&f.io[0x50], 0x20D0);  // darken OBJ, backdrop second target
+        render();
+        expect_pixel(object_pixel, 132, 0, 0, "opaque OBJ darkens via BLDCNT");
+        store16(&f.io[0x50], 0x2090);  // brighten OBJ
+        render();
+        expect_pixel(object_pixel, 255, 132, 132, "opaque OBJ brightens via BLDCNT");
+        store16(&f.io[0x50], 0x2050);  // alpha: OBJ first, backdrop second
+        render();
+        expect_pixel(object_pixel, 132, 0, 132, "opaque OBJ alpha via BLDCNT");
+        store16(&f.io[0x50], 0x20C0);  // OBJ not a first target
+        render();
+        expect_pixel(object_pixel, 255, 0, 0, "opaque OBJ ignores unselected brightness");
+        store16(f.oam.data(), 0x0400);  // semitransparent OBJ
+        render();
+        expect_pixel(object_pixel, 132, 0, 132, "semitransparent OBJ forces alpha during darken");
+    }
     test_alpha_native_domain_and_green_precision();
     test_brightness_native_domain_and_green_precision();
     test_extended_view_geometry_and_clamp();
